[Unit]
Description=ZhiRun local dashboard server
Requires=zhirun-boot-prepare.service
After=network.target zhirun-boot-prepare.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=HwHiAiUser
WorkingDirectory=/opt/zhirun
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/zhirun/server/zhirun_server.py
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
