[Unit]
Description=ZhiRun public dashboard server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=zhirun
Group=zhirun
WorkingDirectory=/opt/zhirun
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/zhirun/server.env
ExecStart=/opt/zhirun/.venv/bin/python /opt/zhirun/server/zhirun_server.py
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
