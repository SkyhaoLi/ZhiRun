[Unit]
Description=ZhiRun Atlas 200I DK A2 sensor collector
Requires=zhirun-boot-prepare.service
After=network-online.target zhirun-boot-prepare.service zhirun-server.service
Wants=network-online.target zhirun-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=dialout
WorkingDirectory=/home/HwHiAiUser/zhirun
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/local/sbin/zhirun-esp-safe-init
ExecStart=/usr/bin/python3 -B /home/HwHiAiUser/zhirun/edge/atlas200i_collector.py --config /home/HwHiAiUser/.config/zhirun-atlas.env
StandardOutput=append:/home/HwHiAiUser/zhirun/atlas-collector-live.log
StandardError=append:/home/HwHiAiUser/zhirun/atlas-collector-live.log
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
