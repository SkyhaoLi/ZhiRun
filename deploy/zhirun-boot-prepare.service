[Unit]
Description=Prepare Atlas network paths for ZhiRun
After=systemd-networkd.service systemd-resolved.service
Wants=systemd-networkd.service systemd-resolved.service
Before=zhirun-server.service zhirun-atlas-collector.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zhirun-boot-prepare
TimeoutStartSec=160
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
