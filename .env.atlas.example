# Atlas 200I DK A2 collector configuration. Copy to /etc/zhirun-atlas.env.
# The public ZhiRun server must use the same ZHIRUN_PUSH_TOKEN.
ZHIRUN_ATLAS_SERVER=http://YOUR_SERVER:10000
ZHIRUN_ATLAS_TOKEN=REPLACE_WITH_PUSH_TOKEN
ZHIRUN_ATLAS_DEVICE_ID=atlas-200i-dk-a2
ZHIRUN_ATLAS_DEVICE_NAME=Atlas 200I DK A2
# Optional dashboard-only address; leave empty to show the routed address.
ZHIRUN_DISPLAY_IP=

# The USB-to-RS485 adapter. Confirm with: ls -l /dev/serial/by-id/
ZHIRUN_RS485_PORT=/dev/ttyUSB0
ZHIRUN_RS485_BAUD=4800
ZHIRUN_MODBUS_TIMEOUT_S=0.35
ZHIRUN_POLL_INTERVAL_S=2
ZHIRUN_PUSH_TIMEOUT_S=1.0

# Existing confirmed Modbus addresses.
ZHIRUN_SOIL_ADDR=2
ZHIRUN_TH_ADDR=1
ZHIRUN_CO2_ADDR=3
ZHIRUN_LIGHT_ADDR=5
# All sensors share one USB-RS485 bus. Polling switches to 19200 only for
# the wind sensor, then returns to 4800 for the louver box and soil probe.
ZHIRUN_WIND_ADDR=4
ZHIRUN_WIND_REG=0
ZHIRUN_WIND_BAUD=4800
ZHIRUN_WIND_FUNCTION=3
ZHIRUN_WIND_HOLD_S=15
ZHIRUN_SENSOR_HOLD_S=60
ZHIRUN_CLIMATE_SNAPSHOT_HOLD_S=300
ZHIRUN_SOIL_SNAPSHOT_HOLD_S=300
ZHIRUN_ENABLE_SOIL=1
ZHIRUN_ENABLE_TH=1
ZHIRUN_ENABLE_CO2=1
ZHIRUN_ENABLE_LIGHT=1

# Atlas Linux GPIO line. Set it only after verifying the
# board's GPIO mapping. The stated physical connection is rain DO -> GPIO16.
ZHIRUN_RAIN_GPIO=16
ZHIRUN_RAIN_EDGE=falling
# Debounce interval for the tipping-bucket contact (milliseconds).
ZHIRUN_RAIN_DEBOUNCE_MS=300
ZHIRUN_RAIN_MM_PER_TIP=0.3
ZHIRUN_RAIN_STATE_FILE=/var/lib/zhirun-atlas/rain_state.json

# Water-pump MOS driver on physical header pin 15 (board GPIO22 / SoC GPIO2_15).
# The Atlas Linux sysfs global line for GPIO2_15 is 79.
ZHIRUN_VALVE_GPIO=79
ZHIRUN_VALVE_ACTIVE_HIGH=1
ZHIRUN_VALVE_MAX_RUN_S=180
ZHIRUN_VALVE_POLL_S=1

# ESP32 pump controller connected to the Atlas through USB/UART.
# Confirm the stable device path with: ls -l /dev/serial/by-path/
ZHIRUN_ESP_SERIAL_PORT=/dev/serial/by-path/REPLACE_WITH_ESP32_PATH
ZHIRUN_ESP_SERIAL_BAUD=115200
