[Unit]
Description=ZhiRun Atlas 200I DK A2 sensor collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/zhirun
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/zhirun/edge/atlas200i_collector.py --config %h/.config/zhirun-atlas.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
